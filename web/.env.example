# Copy to web/.env.local to override. None of these are secrets; never put an API key here,
# because every VITE_* value is bundled into the browser code.

# Where the dev/preview server forwards /api requests (the FastAPI backend).
API_PROXY_TARGET=http://127.0.0.1:8000

# Base path the browser uses for API calls. Keep /api to go through the proxy above.
VITE_API_BASE_URL=/api

# Client-side pre-checks. Keep them in step with the backend's MAX_UPLOAD_MB and
# MAX_QUESTION_CHARS; the backend still enforces its own limits.
VITE_MAX_UPLOAD_MB=10
VITE_MAX_QUESTION_CHARS=1000
